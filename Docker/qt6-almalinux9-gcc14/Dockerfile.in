ARG VERSION=latest
FROM dockbuild/almalinux9-devtoolset14-gcc14:${VERSION}

LABEL maintainer="3D Slicer Community <slicer-devel@bwh.harvard.edu>"

ARG QT_ACCOUNT_LOGIN
ARG QT_ACCOUNT_PASSWORD

#include "common.pre-exec"

RUN \
  #
  # Qt dependencies:
  #
  # * https://doc.qt.io/qt-6/linux-requirements.html
  # * https://doc.qt.io/qt-6/supported-platforms.html
  #
dnf install -y\
    epel-release \
&& \
dnf install -y\
    fontconfig-devel \
    freetype-devel \
    gtk3-devel \
    libX11-devel \
    libX11-xcb \
    libxcb-devel \
    xcb-util-cursor-devel \
    xcb-util-renderutil-devel \
    xcb-util-image-devel \
    xcb-util-keysyms-devel \
    xcb-util-wm-devel \
    xcb-util-devel \
    libxcb-devel \
    libXrender-devel \
    libXext-devel \
    libXfixes-devel \
    libXi-devel \
    libxkbcommon-devel \
    libxkbcommon-x11-devel \
    xorg-x11-proto-devel \
    at-spi2-core-devel \
    mesa-libGL-devel \
    mesa-libEGL-devel \
  && \
  # Dependencies of Xvfb GLX environment
  dnf install -y \
    xorg-x11-server-Xvfb \
    xorg-x11-server-Xorg \
    mesa-dri-drivers \
    glx-utils \
  && \
  dnf install -y \
    alsa-lib \
    libXcomposite \
    libXcursor \
    libXrandr \
    libXtst \
    nss \
    mesa-libEGL \
  && \
  dnf install -y \
    pulseaudio-libs \
    pulseaudio-libs-glib2 \
  && \
  #
  # Slicer dependencies
  #
  # * perl provides all core modules (e.g FindBin, IPC::Cmd) required to configure OpenSSL.
  #   On AlmaLinux 9, perl-interpreter only provides a minimal set of modules.
  #
  dnf install -y \
    perl \
    subversion \
  && \
  #
  # SlicerJupyter dependencies
  #
  dnf install -y \
    libuuid-devel \
  && \
  #
  # SlicerIMSTK dependencies
  #
  dnf install -y \
    libusbx-devel \
  && \
  #
  # Download and install Qt: new Qt installer 4.0 CLI interface
  #
  cd /usr/src && \
  INSTALLER=qt-online-installer-linux-x64-online.run && \
  curl -LO https://download.qt.io/official_releases/online_installers/${INSTALLER} && \
  chmod u+x ${INSTALLER} && \
  # See CLI parameters here: https://wiki.qt.io/Online_Installer_4.x
  ./${INSTALLER} \
    install \
      qt.qt6.6112.linux_gcc_64 \
      qt.qt6.6112.addons.qt5compat \
      qt.qt6.6112.addons.qtmultimedia \
      qt.qt6.6112.addons.qtpositioning \
      qt.qt6.6112.addons.qtscxml \
      qt.qt6.6112.addons.qtwebchannel \
      extensions.qtwebengine.6112.linux_gcc_64 \
    --root /opt/qt \
    --email ${QT_ACCOUNT_LOGIN} \
    --pw ${QT_ACCOUNT_PASSWORD} \
    --verbose \
    --platform minimal \
    --accept-licenses \
    --accept-obligations \
    --confirm-command \
    --auto-answer telemetry-question=No,AssociateCommonFiletypes=No,installationErrorWithCancel=Ignore,OverwriteTargetDirectory=No &&\
  rm -f ${INSTALLER} && \
  #
  # Check that the Qt modules required by Slicer are installed. The installer is run
  # with "installationErrorWithCancel=Ignore" and does not fail if a component cannot
  # be selected.
  #
  for module in Core5Compat Multimedia MultimediaWidgets Positioning StateMachine WebChannel WebEngineCore WebEngineWidgets; do \
    test -d /opt/qt/6.11.2/gcc_64/lib/cmake/Qt6${module} || { echo "error: Qt6${module} is not installed"; exit 1; }; \
  done && \
  #
  # Cleanup
  #
  find /opt/qt -maxdepth 1 -type f -exec rm -rf "{}" \; && \
  find /opt/qt -type f -name "*.debug" -delete && \
  find /opt/qt/6.11.2/gcc_64/bin -type f -executable -exec strip {} \; && \
  rm -rf \
    /opt/qt/dist \
    /opt/qt/Docs \
    /opt/qt/Examples \
    /opt/qt/Tools \
  && \
  #
  # Cleanup
  #
  dnf clean all && \
  rm -rf /var/cache/dnf

#
# (1) Add Qt root directory to the PATH. This allows CMake command
#     'find_package(Qt6 REQUIRED)` to succeed.
#
# (2) Set env. variable Qt6_DIR to support configuring project
#     by explicitly passing -DQt6_DIR:PATH=${Qt6_DIR}
#
ENV PATH=/opt/qt/6.11.2/gcc_64/:${PATH} \
    Qt6_DIR=/opt/qt/6.11.2/gcc_64/lib/cmake/Qt6

#include "common.label-and-env"
